# Copy to .env (git-ignored). Every variable the engine reads is listed here (AGENTS.md rule 8).

# Frozen demo clock for seed availability windows, ISO date (D-14).
DEMO_TODAY=2026-09-22

# Minimum overlap in days between a builder interval and the brief window (D-08).
MIN_OVERLAP_DAYS=2

# Set to 1 to expose POST /internal/query (dev-only). Leave unset in any deployed engine.
ENGINE_DEV_QUERY=0

# Host port published by docker compose for the engine service.
ENGINE_PORT=8000

# LLM adapter (D-06). anthropic uses the official SDK with claude-opus-5; null serves every
# response type without a model. With ANTHROPIC_API_KEY unset the engine always uses null.
LLM_PROVIDER=anthropic
# Server-side only; never sent to the browser. Placeholder: replace in .env (D-26).
ANTHROPIC_API_KEY=
