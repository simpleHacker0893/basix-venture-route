# Venture Route — environment template. Copy to `.env` at the repo root (git-ignored) and fill in
# the placeholders. Every variable any service reads is listed here with a comment (AGENTS.md
# rule 8; D-26: keys arrive only through `.env`, never in chat or in a tracked file).
#
# Who reads this file:
#   - docker compose (root `.env`) → passes values into the `engine`, `db` and `web` services
#   - services/engine (pydantic-settings) → reads the repo-root `.env`, then an optional
#     services/engine/.env that overrides it
#   - apps/web (Vite, Sprint 002) → reads only variables prefixed `VITE_` at build time
#
# "Read by" says which sprint's code consumes the variable. Later-sprint variables are listed so
# the Operator can fill them in early; they are ignored until that sprint lands.

# ---------------------------------------------------------------------------------------------
# Engine: routing core (services/engine) — read by Sprint 000 / 001
# ---------------------------------------------------------------------------------------------

# Frozen demo clock for seed availability windows, ISO date (D-14).
DEMO_TODAY=2026-09-22

# Minimum inclusive overlap, in days, between a builder interval and the brief window (D-08).
MIN_OVERLAP_DAYS=2

# Set to 1 to expose POST /internal/query (dev-only). Leave 0 in any deployed engine.
ENGINE_DEV_QUERY=0

# Host port published by docker compose for the engine service.
ENGINE_PORT=8000

# Browser origins allowed to call the engine, comma-separated (D-30). Vite dev and vite preview
# by default; Sprint 005 adds the Vercel URL on the host.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# LLM adapter (D-06). `anthropic` uses the official SDK with claude-opus-5 for intake and the
# route summary; `null` serves every response type without a model (the structured form is then
# the only input path). With ANTHROPIC_API_KEY empty the engine always uses `null`.
LLM_PROVIDER=anthropic

# Server-side only; never sent to the browser. Replace the placeholder in `.env` (D-26).
ANTHROPIC_API_KEY=sk-ant-replace-me

# ---------------------------------------------------------------------------------------------
# Engine: marketplace store and auth — read from Sprint 003 (D-03, D-17)
# ---------------------------------------------------------------------------------------------

# Neon Postgres, pooled connection string (D-17), in the asyncpg form: `postgresql+asyncpg://`
# and `?ssl=require` (asyncpg does not accept `sslmode`). Leaving the USER:PASSWORD@HOST
# placeholder means "no store": routing runs from seed only and marketplace routes answer 503.
# `docker compose` ignores this and builds its own URL from the POSTGRES_* variables below.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require

# Neon direct (unpooled) connection string for Alembic migrations: PgBouncer in transaction mode
# does not suit DDL. Alembic resolves ALEMBIC_DATABASE_URL, then this, then DATABASE_URL.
DATABASE_URL_DIRECT=postgresql+asyncpg://USER:PASSWORD@HOST-DIRECT/DB?ssl=require

# Explicit override Alembic checks first (`alembic/env.py`): CI and the pytest conftest set it to
# the test database, and a one-off migration can point it at any empty database. Leave empty to
# fall back to DATABASE_URL_DIRECT, then DATABASE_URL.
ALEMBIC_DATABASE_URL=

# Database the marketplace tests run against: the Neon `test` branch or a local postgres:18
# (D-37), e.g. postgresql+asyncpg://postgres:postgres@localhost:5432/venture_route_test.
# pytest drops the schema and runs `alembic upgrade head` on it once per session; never point
# it at a database you care about. Unset or placeholder → the marketplace tests skip.
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB_TEST?ssl=require

# Compose `db` service (postgres:18, D-37). Local only; the engine container derives its
# DATABASE_URL from these three.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=venture_route
POSTGRES_PORT=5432

# Clerk (D-03): the FastAPI service verifies session JWTs against this JWKS and reads the role
# from publicMetadata; the secret key calls the Backend API; the signing secret verifies the
# user.created / user.updated webhook. Values come from the Clerk dashboard (Q-03).
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_replace-me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace-me

# Comma-separated emails bootstrapped as the first admin(s) on sign-up (D-03).
ADMIN_EMAILS=admin@example.com

# ---------------------------------------------------------------------------------------------
# Web app (apps/web, Vite) — read from Sprint 002; only VITE_* reaches the browser
# ---------------------------------------------------------------------------------------------

# Base URL of the FastAPI engine the browser talks to. Vercel gets the Railway public URL (D-27).
VITE_API_URL=http://localhost:8000

# Clerk publishable key (safe for the browser); pairs with CLERK_SECRET_KEY above.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace-me

# Set to 1 to load the five seed routes from a static JSON snapshot for the recorded fallback.
VITE_OFFLINE_DEMO=0

# Chloe's voice device layer (Sprint 006, D-38; apps/web/src/voice/selectProvider.ts): `web`
# (default) uses the browser's SpeechRecognition/speechSynthesis; `fake` is the RTL and
# Playwright test double; `off` shows no voice UI at all. Also off whenever VITE_OFFLINE_DEMO=1.
VITE_VOICE_PROVIDER=web
